# Global environment example for the flex-agent-chat stack.
# Copy to .env and fill in real values (this file has no secrets).
# NB: docker --env-file values are literal — do NOT shell-quote them.
# Variables here are read by chat/ scripts and start-dev.sh.
# When running inside containers, override localhost URLs with
# host.docker.internal or the actual service hostnames.

# Rocket.Chat server (host-pinned; override in containers)
ROCKETCHAT_URL=http://localhost:3000
ROCKETCHAT_ADMIN_USER=admin
# ROCKETCHAT_ADMIN_PASSWORD=set-me-in-.env-not-here
ROCKETCHAT_ADMIN_PASSWORD=<set-me>

# Rocket.Chat peer / DM target
ROCKETCHAT_PEER_USERNAME=peer

# Rocket.Chat synthetic-email domain and debug flag
ROCKETCHAT_EMAIL_DOMAIN=localhost
ROCKETCHAT_DEBUG=0

# Gitea server (host-pinned; override in containers)
GITEA_URL=http://localhost:3001
# GITEA_TOKEN=set-me-in-.env-not-here
GITEA_TOKEN=<set-me>

# Gitea webhook receiver
GITEA_WEBHOOK_PORT=3030
GITEA_WEBHOOK_BIND=127.0.0.1
GITEA_WEBHOOK_SECRET=<set-me>

# opencode server (opencode 2.x log levels are lowercase-only)
OPENCODE_HOSTNAME=127.0.0.1
OPENCODE_PORT=4096
OPENCODE_LOG_LEVEL=info
OPENCODE_SERVER_PASSWORD=<set-me>

# Provider API key: consumed by docker/entrypoint.sh, which mints
# $HOME/.local/share/opencode/auth.json from it at container boot.
OPENCODE_API_KEY=<set-me>

# Default model for new gateway sessions. Use the provider/model form
# (e.g. opencode/longcat-2.5-preview-free). The gateway splits this and
# posts a bare model id; a provider-qualified id double-prefixes and fails.
OPENCODE_MODEL=opencode/longcat-2.5-preview-free
