# Per-agent environment example.
# Copy to .agent_env at the repo root and fill in real values.
# This file has no secrets; replace placeholders before use.
# NB: docker --env-file values are literal — do NOT shell-quote them.

# Rocket.Chat agent identity
ROCKETCHAT_AGENT_USERNAME=agent
# ROCKETCHAT_AGENT_PASSWORD=set-me-in-.agent_env-not-here
ROCKETCHAT_AGENT_PASSWORD=<set-me>

# Per-agent Gitea token (minted by provision_gitea.py)
GITEA_TOKEN=<set-me>
